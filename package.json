{
  "name": "pneuma",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run dev -w @pneuma/web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gate": "node scripts/check-boundaries.mjs",
    "test": "tsx --test packages/core/test/*.test.ts",
    "build": "npm run build -w @pneuma/web",
    "licenses": "node scripts/gen-licenses.mjs",
    "icon": "node scripts/gen-icon.mjs",
    "desktop:build": "npm run build -w @pneuma/desktop",
    "verify": "npm run licenses && npm run typecheck && npm run gate && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}